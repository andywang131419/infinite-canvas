# Infinite Canvas 后端 —— 本地开发用环境变量
#
# 用法（server/ 目录下）：
#   cp .env.example .env
#   bun run dev
#
# Bun 会自动加载 ./.env，无需 dotenv。
# 生产环境请改用 deploy/.env.example（由 docker compose 注入）。

# ===== 基础 =====
NODE_ENV=development
APP_VERSION=0.20.0-fork.1
HTTP_PORT=8787
HTTP_HOST=0.0.0.0
LOG_LEVEL=debug

# ===== 数据库（bun:sqlite）=====
# 本地开发用相对路径，避免依赖 /data 目录。
DATABASE_PATH=./data/app.db
DB_BUSY_TIMEOUT_MS=5000
MIGRATIONS_DIR=migrations

# ===== 鉴权 =====
# 必填，至少 32 字符。生成：openssl rand -base64 48
AUTH_SECRET=dev-only-secret-please-replace-with-openssl-rand-base64-48
SESSION_TTL_DAYS=30
# 会话 Cookie 名（HttpOnly）。一般不用改。
SESSION_COOKIE_NAME=ic_session
ALLOW_REGISTRATION=false
LOGIN_RATE_LIMIT_PER_MIN=5
# 本地 http://localhost 调试必须 false，否则浏览器不保存 Cookie。
# 生产（Caddy 提供 HTTPS）必须 true。
COOKIE_SECURE=false
# 本地直连 `bun run dev` 时设为 false：否则客户端伪造 X-Forwarded-For 可绕过登录限流。
# 经 Caddy 反代时必须 true，否则所有请求都算到同一个内网 IP。
TRUST_PROXY=false

# ===== 存储 =====
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/media
MAX_UPLOAD_MB=200
MAX_DOC_JSON_MB=8

# ===== 任务 / Worker =====
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=2
JOB_IMAGE_TIMEOUT_S=180
JOB_VIDEO_TIMEOUT_S=600
JOB_RETRY_BACKOFF_S=30
MODEL_SCRIPT_ENABLED=false

# ===== 上游 / 安全面 =====
LOCAL_AGENT_ENABLED=false
UPSTREAM_HOST_ALLOWLIST=

# ===== 备份（T03 起可手动触发：POST /api/backups/run）=====
# 本地开发默认关闭；生产由 deploy/.env 打开
BACKUP_ENABLED=false
BACKUP_CRON=0 3 * * *
BACKUP_DB_KEEP_DAYS=14
BACKUP_RETRY=3
BACKUP_TARGET_LABEL=
# 快照暂存目录（务必在持久卷上）
BACKUP_STAGE_DIR=/data/backups
# 是否把媒体目录的"文件数/字节数"统计进审计行（默认 true）。
# 注意：服务端**只统计不打包**（媒体动辄几十 GB，放在请求里 tar 会长时间占 IO），
# 真正的 tar 打包由 cron 容器的 backup.sh 负责，两边的 BACKUP_INCLUDE_MEDIA 要一致。
BACKUP_INCLUDE_MEDIA=true
RCLONE_REMOTE=
RCLONE_DEST=
