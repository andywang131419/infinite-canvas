# =============================================================================
# 生产部署环境变量（ARCH Rev2 §R10 定稿）
#
# 用法：
#   cd deploy
#   cp .env.example .env
#   # 必改：AUTH_SECRET（否则 compose 拒绝启动）、APP_DOMAIN / TLS_MODE
#   docker compose up -d --build
#
# ⚠️ .env 含密钥，已被 .gitignore 忽略，切勿提交。
# =============================================================================

# ===== 入口 / 域名 =====
# 真实域名（如 canvas.example.com）；留空则用 localhost 自签。
APP_DOMAIN=localhost
# TLS_MODE=internal  → Caddy 自签（仅本机/内网，浏览器会警告）
# TLS_MODE=you@x.com → 自动申请 Let's Encrypt 证书（需要公网可达 + 域名解析到本机）
TLS_MODE=internal
APP_VERSION=0.20.0-fork.1
LOG_LEVEL=info

# ===== 数据库（bun:sqlite）=====
DATABASE_PATH=/data/app.db
DB_BUSY_TIMEOUT_MS=5000

# ===== 鉴权 =====
# 【必填】至少 32 字符。生成：
#   openssl rand -base64 48
# 或：  head -c 48 /dev/urandom | base64
AUTH_SECRET=
SESSION_TTL_DAYS=30
# 会话 Cookie 名（HttpOnly）。一般不用改。
SESSION_COOKIE_NAME=ic_session
ALLOW_REGISTRATION=false
LOGIN_RATE_LIMIT_PER_MIN=5
# 走 HTTPS 时必须 true；仅本机 http 调试可临时 false
COOKIE_SECURE=true
# 【生产必须 true】经 Caddy 反代时读 X-Forwarded-For 才能拿到真实客户端 IP，
# 否则"同 IP+账号 5 次/分"的登录限流会退化成"全站共用一个内网 IP"。
# 只有在**直接**把 8787 端口暴露到公网（不推荐）时才设 false。
TRUST_PROXY=true

# ===== 存储 =====
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/media
MAX_UPLOAD_MB=200
MAX_DOC_JSON_MB=8
# S3_*（仅 STORAGE_DRIVER≠local 时生效，P1）
# S3_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
# S3_REGION=ap-shanghai
# S3_BUCKET=ic-media-125xxxx
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=

# ===== 任务 / Worker =====
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=2
JOB_IMAGE_TIMEOUT_S=180
JOB_VIDEO_TIMEOUT_S=600
JOB_RETRY_BACKOFF_S=30
# Tier3：首版必须 false（模型自定义脚本要求把 Key 下发浏览器，违反 P0-08）
MODEL_SCRIPT_ENABLED=false

# ===== 上游 / 安全面 =====
# 上游 canvas-agent（本机 Codex 编排），默认关闭；且它不经服务端，与 P0-08 无冲突
LOCAL_AGENT_ENABLED=false
# 额外放行的出站域名（逗号分隔），通常留空
UPSTREAM_HOST_ALLOWLIST=

# 【必读】生图/生视频结果的下载域名白名单（逗号分隔）
#
# 为什么必须配：图片/视频结果通常以 URL 形式返回，这个 URL 来自**上游响应体**，
# 不在客服端可控范围内，所以服务端必须自己判断能不能去抓。留空 = 拒绝一切结果下载，
# 表现为"生成成功但画布里没有图"。
#
# 注意这个域名通常与你调用的 API 域名**不同**（结果多落在独立 CDN / 对象存储上）。
# 首次上线建议：先用中转站跑一次生图，看服务端日志里被拒绝的域名，再逐项加进来。
#
# 示例（按你实际用的中转站填，不要照抄）：
#   RESULT_DOWNLOAD_ALLOWLIST=files.examplecdn.com,oss-cn-beijing.aliyuncs.com
RESULT_DOWNLOAD_ALLOWLIST=

# ===== 备份 =====
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_DB_KEEP_DAYS=14
BACKUP_RETRY=3
# 仅用于前端展示，脱敏；别写真密钥
BACKUP_TARGET_LABEL=
# rclone 远端名（对应 deploy/rclone/rclone.conf 里的 [section]）；留空=只备份到本地 /data/backups
RCLONE_REMOTE=
RCLONE_DEST=
# 快照暂存目录（服务端手动备份与 backup.sh 共用，务必落在持久卷上）
BACKUP_STAGE_DIR=/data/backups
# 【重要】是否把 /data/media 下的图片/视频**一起打包备份**（默认 true）。
#   false 时备份只包含 app.db（画布 JSON），媒体文件零备份 —— 恢复后画布里
#   所有图都会 404，所以除非你另有一套对象存储备份，否则不要关掉它。
#   媒体是全量 tar 打包，磁盘峰值约等于"媒体总量 + 数据总量"，请据此留足空间。
BACKUP_INCLUDE_MEDIA=true
TZ=Asia/Shanghai

# ===== 前端运行时（web 容器读取，写入 config.js）=====
# 留空 = 同域（推荐，配合 Caddy 分流）
# 拆子域时才填，例如 https://api.example.com
API_BASE_URL=
ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
